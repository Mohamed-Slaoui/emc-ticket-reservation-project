# ==============================================================================
# Template of the environment file.
#
# Copy to `.env.local` (never commit that file) and override what you need:
#     cp .env.example .env.local
#
# `.env` itself IS committed: it holds only non-secret defaults, so that a
# fresh clone boots without any manual step. Real credentials (database
# passwords, API keys, Google service-account keys) belong in `.env.local`
# or in real environment variables, which always win over the files.
#
# Rules:
#   - never put a real secret in this file;
#   - never commit `.env.local`, `.env.*.local` or `.env.local.php`.
# ==============================================================================

###> symfony/framework-bundle ###
APP_ENV=dev
# Placeholder only. Generate a real one with:
#   php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
APP_SECRET=dev_only_secret_change_me_0123456789abcdef
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# The default below matches the MySQL 8 container started by `docker compose up -d database`.
# The password must match MYSQL_PASSWORD in compose.yaml.
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Transport used by the outbox worker (Google Sheets synchronization).
# The `doctrine` transport keeps the messages in the `messenger_messages`
# table, which is created by the migrations.
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
# `null://null` disables mail sending. The Docker Compose stack provides
# Mailpit (SMTP 1025, web UI 8025) for local inspection.
MAILER_DSN=null://null
###< symfony/mailer ###

###> google/sheets ###
# Google Sheets integration (level 4). Credentials come from a service
# account; never commit the JSON key file itself.
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
###< google/sheets ###
