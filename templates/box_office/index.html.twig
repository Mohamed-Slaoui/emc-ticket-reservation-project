{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}Box office{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: 'Box office',
        subtitle: 'Sell tickets at the counter, the same way they are sold online.',
    } %}

    {% include '_components/flash.html.twig' %}

    <form method="get" class="list-toolbar" data-turbo="false">
        <div class="search" style="max-width: 24rem;">
            <span class="search__icon">{{ icon('search', 'icon icon--sm') }}</span>
            <input class="search__input" type="search" name="q" value="{{ q }}" placeholder="Event, venue or room…" aria-label="Search">
        </div>
        <button type="submit" class="button button--secondary">Search</button>
        {% if q %}
            <a class="button button--ghost" href="{{ path('box_office_index') }}">Clear</a>
        {% endif %}
    </form>

    {% set body %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Event</th>
                        <th>Venue</th>
                        <th>Seats left</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% if performances is empty %}
                        <tr>
                            <td colspan="5" class="u-muted" style="text-align:center; padding: var(--space-6);">Nothing on sale{% if q %} for « {{ q }} »{% endif %} yet.</td>
                        </tr>
                    {% endif %}
                    {% for performance in performances %}
                        {% set left = available[performance.id] %}
                        <tr>
                            <td class="u-nowrap">
                                <div class="table__identity-text">
                                    <div class="table__identity-name">{{ performance.startsAt|date('d/m/Y') }}</div>
                                    <div class="table__identity-mail u-mono">{{ performance.startsAt|date('H:i') }}</div>
                                </div>
                            </td>
                            <td>
                                <div class="table__identity-text">
                                    <div class="table__identity-name">{{ labels[performance.id]|default(performance.event.title) }}</div>
                                    <div class="table__identity-mail">{{ performance.seatingLayout.room.venue.name }}</div>
                                </div>
                            </td>
                            <td>{{ performance.seatingLayout.room.name }}</td>
                            <td>
                                {% if left > 0 %}
                                    {{ left }}
                                {% else %}
                                    <span class="badge badge--danger">Sold out</span>
                                {% endif %}
                            </td>
                            <td class="table__cell--actions">
                                <a class="button button--primary button--sm" href="{{ path('box_office_performance', {id: performance.id}) }}" {{ left == 0 ? 'aria-disabled="true" style="pointer-events:none; opacity:.5;"' : '' }}>
                                    {{ icon('ticket', 'icon icon--sm') }}
                                    Sell
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endset %}

    {% include '_components/card.html.twig' with { variant: 'card--flat', body: body } %}
{% endblock %}
