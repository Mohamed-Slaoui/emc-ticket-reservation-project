{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}Rooms{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: 'Rooms',
        subtitle: 'The rooms of the venue, and the places they hold.',
        action_label: 'Add a room',
        action_path: path('admin_rooms_new'),
        action_icon: 'plus',
    } %}

    {% include '_components/flash.html.twig' %}

    {% if rooms is empty %}
        {% include '_components/empty_state.html.twig' with {
            iconName: 'room',
            title: venue ? 'No room in this venue' : 'No room yet',
            text: venue
                ? 'This venue holds no room yet.'
                : 'Add the rooms of the venue, then fill them with seats.',
            action_label: 'Add a room',
            action_path: path('admin_rooms_new'),
            action_icon: 'plus',
        } %}
    {% else %}
        {% set body %}
            <form method="get" class="list-toolbar" data-turbo="false">
                <div class="search">
                    <span class="search__icon">{{ icon('filter', 'icon icon--sm') }}</span>
                    <select class="search__input" name="venue">
                        <option value="">Every venue</option>
                        {% for v in venues %}
                            <option value="{{ v.id }}" {{ venue and venue.id == v.id ? 'selected' : '' }}>{{ v.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="button button--outline">Filter</button>
                {% if venue %}
                    <a class="button button--ghost" href="{{ path('admin_rooms') }}">Clear</a>
                {% endif %}

                {% include '_components/page_size.html.twig' with {current: perPage} %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Room</th>
                            <th>Venue</th>
                            <th>Places</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for room in rooms %}
                            <tr>
                                <td>
                                    <div class="table__identity">
                                        <span class="card__icon">{{ icon('room', 'icon icon--sm') }}</span>
                                        <div class="table__identity-text">
                                            <div class="table__identity-name">{{ room.name }}</div>
                                            {% if room.description %}
                                                <div class="table__identity-mail">{{ room.description }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td class="table__cell--muted">{{ room.venue.name }}</td>
                                <td>
                                    <a class="badge badge--accent" href="{{ path('admin_places', {room: room.id}) }}">
                                        {{ placeCounts[room.id] }} place{{ placeCounts[room.id] > 1 ? 's' : '' }}
                                    </a>
                                </td>
                                <td class="table__cell--actions">
                                    <span class="u-flex u-gap-2" style="justify-content: flex-end;">
                                        <a class="button button--ghost button--icon" href="{{ path('admin_places', {room: room.id}) }}"
                                           title="Places" aria-label="Places of {{ room.name }}">
                                            {{ icon('seat', 'icon icon--sm') }}
                                        </a>
                                        <a class="button button--ghost button--icon" href="{{ path('admin_rooms_edit', {id: room.id}) }}"
                                           title="Edit" aria-label="Edit {{ room.name }}">
                                            {{ icon('pencil', 'icon icon--sm') }}
                                        </a>
                                        <form method="post" action="{{ path('admin_rooms_delete', {id: room.id}) }}"
                                              data-turbo-confirm="Delete the room {{ room.name }}? Its seating configurations and its seats will be deleted too. This cannot be undone.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_room_' ~ room.id) }}">
                                            <button class="button button--danger-ghost button--icon" type="submit"
                                                    title="Delete" aria-label="Delete {{ room.name }}">
                                                {{ icon('trash', 'icon icon--sm') }}
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set footer %}
            {% include '_components/pagination.html.twig' with {
                pagination: pagination,
                route: 'admin_rooms',
                query: {venue: venue ? venue.id : null},
            } %}
        {% endset %}

        {% include '_components/card.html.twig' with {
            variant: 'card--flat',
            body: body,
            footer: footer,
        } %}
    {% endif %}
{% endblock %}
