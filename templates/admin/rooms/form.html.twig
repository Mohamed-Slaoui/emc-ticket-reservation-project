{% extends 'base.html.twig' %}

{% block title %}{{ room ? 'Edit the room' : 'New room' }}{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: room ? 'Edit the room' : 'New room',
        subtitle: room
            ? 'Change the name or the description of the room.'
            : 'Add a room to the venue.',
        action_label: 'Back to the rooms',
        action_path: path('admin_rooms'),
        action_icon: 'arrow-left',
        action_variant: 'outline',
    } %}

    {% include '_components/flash.html.twig' %}

    {% set form %}
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_row(form.venue) }}
            {{ form_row(form.name) }}
            {{ form_row(form.description) }}

            <div class="form__actions">
                <button type="submit" class="button button--primary">
                    {{ room ? 'Save the changes' : 'Create the room' }}
                </button>
                <a class="button button--ghost" href="{{ path('admin_rooms') }}">Cancel</a>
            </div>
        {{ form_end(form) }}
    {% endset %}

    {% include '_components/card.html.twig' with { body: form } %}
{% endblock %}
