{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}Venues{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: 'Venues',
        subtitle: 'The venues where the performances take place.',
        action_label: 'Add a venue',
        action_path: path('admin_venues_new'),
        action_icon: 'plus',
    } %}

    {% include '_components/flash.html.twig' %}

    {% if venues is empty %}
        {% include '_components/empty_state.html.twig' with {
            iconName: 'venue',
            title: 'No venue yet',
            text: 'Describe the venue where the performances take place, then add its rooms.',
            action_label: 'Add a venue',
            action_path: path('admin_venues_new'),
            action_icon: 'plus',
        } %}
    {% else %}
        {% set body %}
            <form method="get" class="list-toolbar" data-turbo="false">
                {% include '_components/page_size.html.twig' with {current: perPage} %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Venue</th>
                            <th>Address</th>
                            <th>Rooms</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for venue in venues %}
                            <tr>
                                <td>
                                    <div class="table__identity">
                                        <span class="card__icon">{{ icon('venue', 'icon icon--sm') }}</span>
                                        <div class="table__identity-text">
                                            <div class="table__identity-name">{{ venue.name }}</div>
                                            {% if venue.description %}
                                                <div class="table__identity-mail">{{ venue.description }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td class="table__cell--muted">{{ venue.address }}</td>
                                <td>
                                    <a class="badge badge--accent" href="{{ path('admin_rooms', {venue: venue.id}) }}">
                                        {{ roomCounts[venue.id] }} room{{ roomCounts[venue.id] > 1 ? 's' : '' }}
                                    </a>
                                </td>
                                <td class="table__cell--actions">
                                    <span class="u-flex u-gap-2" style="justify-content: flex-end;">
                                        <a class="button button--ghost button--icon" href="{{ path('admin_rooms', {venue: venue.id}) }}"
                                           title="Rooms" aria-label="Rooms of {{ venue.name }}">
                                            {{ icon('room', 'icon icon--sm') }}
                                        </a>
                                        <a class="button button--ghost button--icon" href="{{ path('admin_venues_edit', {id: venue.id}) }}"
                                           title="Edit" aria-label="Edit {{ venue.name }}">
                                            {{ icon('pencil', 'icon icon--sm') }}
                                        </a>
                                        <form method="post" action="{{ path('admin_venues_delete', {id: venue.id}) }}"
                                              data-turbo-confirm="Delete the venue {{ venue.name }}? Its rooms, their seating configurations and their seats will be deleted too. This cannot be undone.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_venue_' ~ venue.id) }}">
                                            <button class="button button--danger-ghost button--icon" type="submit"
                                                    title="Delete" aria-label="Delete {{ venue.name }}">
                                                {{ icon('trash', 'icon icon--sm') }}
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set footer %}
            {% include '_components/pagination.html.twig' with {
                pagination: pagination,
                route: 'admin_venues',
            } %}
        {% endset %}

        {% include '_components/card.html.twig' with {
            variant: 'card--flat',
            body: body,
            footer: footer,
        } %}
    {% endif %}
{% endblock %}
