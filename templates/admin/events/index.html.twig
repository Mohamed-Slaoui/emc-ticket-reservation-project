{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}Events{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: 'Events',
        subtitle: 'The programmes of the venue: concerts, theatre pieces and conferences.',
        action_label: 'Add an event',
        action_path: path('admin_events_new'),
        action_icon: 'plus',
    } %}

    {% include '_components/flash.html.twig' %}

    {% if events is empty %}
        {% include '_components/empty_state.html.twig' with {
            iconName: 'calendar',
            title: 'No event yet',
            text: 'Create the programme, then schedule its performances.',
            action_label: 'Add an event',
            action_path: path('admin_events_new'),
            action_icon: 'plus',
        } %}
    {% else %}
        {% set body %}
            <form method="get" class="list-toolbar" data-turbo="false">
                <div class="search">
                    <span class="search__icon">{{ icon('filter', 'icon icon--sm') }}</span>
                    <select class="search__input" name="status">
                        <option value="">Every status</option>
                        {% for value, label in {'DRAFT': 'Draft', 'PUBLISHED': 'Published', 'ARCHIVED': 'Archived'} %}
                            <option value="{{ value }}" {{ status and status.value == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="search">
                    <span class="search__icon">{{ icon('filter', 'icon icon--sm') }}</span>
                    <select class="search__input" name="type">
                        <option value="">Every type</option>
                        {% for value, label in {'CONCERT': 'Concert', 'THEATRE': 'Theatre', 'CONFERENCE': 'Conference', 'OTHER': 'Other'} %}
                            <option value="{{ value }}" {{ type and type.value == value ? 'selected' : '' }}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>

                <button type="submit" class="button button--outline">Filter</button>

                {% include '_components/page_size.html.twig' with {current: perPage} %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Type</th>
                            <th>Performances</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for event in events %}
                            <tr>
                                <td>
                                    <div class="table__identity">
                                        <span class="card__icon">{{ icon('calendar', 'icon icon--sm') }}</span>
                                        <div class="table__identity-text">
                                            <div class="table__identity-name">{{ event.title }}</div>
                                            {% if event.description %}
                                                <div class="table__identity-mail">{{ event.description }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge">
                                        {{ {'CONCERT': 'Concert', 'THEATRE': 'Theatre', 'CONFERENCE': 'Conference', 'OTHER': 'Other'}[event.type.value] }}
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge--accent">
                                        {{ performanceCounts[event.id] }} performance{{ performanceCounts[event.id] > 1 ? 's' : '' }}
                                    </span>
                                </td>
                                <td>
                                    {% if event.status.value == 'PUBLISHED' %}
                                        <span class="badge badge--success">Published</span>
                                    {% elseif event.status.value == 'ARCHIVED' %}
                                        <span class="badge badge--warning">Archived</span>
                                    {% else %}
                                        <span class="badge">Draft</span>
                                    {% endif %}
                                </td>
                                <td class="table__cell--actions">
                                    <span class="u-flex u-gap-2" style="justify-content: flex-end;">
                                        <a class="button button--ghost button--icon" href="{{ path('admin_events_show', {id: event.id}) }}"
                                           title="Open" aria-label="Open {{ event.title }}">
                                            {{ icon('eye', 'icon icon--sm') }}
                                        </a>
                                        <a class="button button--ghost button--icon" href="{{ path('admin_events_edit', {id: event.id}) }}"
                                           title="Edit" aria-label="Edit {{ event.title }}">
                                            {{ icon('pencil', 'icon icon--sm') }}
                                        </a>
                                        <form method="post" action="{{ path('admin_events_delete', {id: event.id}) }}"
                                              data-turbo-confirm="Delete the event {{ event.title }}? Its performances must be deleted first. This cannot be undone.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                                            <button class="button button--danger-ghost button--icon" type="submit"
                                                    title="Delete" aria-label="Delete {{ event.title }}">
                                                {{ icon('trash', 'icon icon--sm') }}
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set footer %}
            {% include '_components/pagination.html.twig' with {
                pagination: pagination,
                route: 'admin_events',
                query: {status: status ? status.value : null, type: type ? type.value : null},
            } %}
        {% endset %}

        {% include '_components/card.html.twig' with {
            variant: 'card--flat',
            body: body,
            footer: footer,
        } %}
    {% endif %}
{% endblock %}
