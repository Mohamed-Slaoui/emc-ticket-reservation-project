{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}{{ event.title }}{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: event.title,
        subtitle: ({
            'CONCERT': 'Concert',
            'THEATRE': 'Theatre',
            'CONFERENCE': 'Conference',
            'OTHER': 'Other'
        })[event.type.value] ~ ' · ' ~ performances|length ~ ' performance' ~ (performances|length > 1 ? 's' : ''),
        action_label: 'Schedule a performance',
        action_path: path('admin_performances_new', {eventId: event.id}),
        action_icon: 'plus',
    } %}

    {% include '_components/flash.html.twig' %}

    <div class="layout-editor">
        {# ------------------------------------------------------------------
           The publication checks.
           ------------------------------------------------------------------ #}
        <aside class="layout-editor__side">
            {% set checksBody %}
                <ul class="checklist">
                    {% for check in checks %}
                        <li class="checklist__item {{ check.ok ? 'checklist__item--ok' : 'checklist__item--ko' }}">
                            <span class="checklist__mark">{{ icon(check.ok ? 'check' : 'close', 'icon icon--sm') }}</span>
                            <div>
                                <div class="checklist__label">{{ check.label }}</div>
                                <div class="checklist__detail">{{ check.detail }}</div>
                            </div>
                        </li>
                    {% endfor %}
                </ul>

                <div class="zone-list__actions">
                    {% if event.status.value == 'PUBLISHED' %}
                        <form method="post" action="{{ path('admin_events_archive', {id: event.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('archive_event_' ~ event.id) }}">
                            <button type="submit" class="button button--outline">Archive the event</button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('admin_events_publish', {id: event.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('publish_event_' ~ event.id) }}">
                            <button type="submit" class="button button--primary">Publish the event</button>
                        </form>
                    {% endif %}

                    <a class="button button--ghost" href="{{ path('admin_events_edit', {id: event.id}) }}">Edit</a>
                </div>
            {% endset %}

            {% include '_components/card.html.twig' with {
                title: 'Publication',
                subtitle: 'An event is published only when it is complete.',
                body: checksBody,
            } %}
        </aside>

        {# ------------------------------------------------------------------
           The performances.
           ------------------------------------------------------------------ #}
        <div class="layout-editor__main">
            {% set performancesBody %}
                {% if performances is empty %}
                    <p class="u-muted u-small">No performance yet. Schedule the first show of the programme.</p>
                {% else %}
                    <div class="table-wrap">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Room</th>
                                    <th>Configuration</th>
                                    <th>Sales</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for performance in performances %}
                                    <tr>
                                        <td>
                                            <div class="table__identity-text">
                                                <div class="table__identity-name">{{ performance.startsAt|date('d/m/Y') }}</div>
                                                <div class="table__identity-mail">{{ performance.startsAt|date('H:i') }}{{ performance.endsAt ? ' – ' ~ performance.endsAt|date('H:i') : '' }}</div>
                                            </div>
                                        </td>
                                        <td class="table__cell--muted">{{ performance.seatingLayout.room.name }}</td>
                                        <td class="table__cell--muted">
                                            {{ performance.seatingLayout.name }}
                                            <span class="u-mono u-small">v{{ performance.seatingLayout.version }}</span>
                                        </td>
                                        <td class="table__cell--muted">
                                            {% if performance.salesOpenAt or performance.salesCloseAt %}
                                                {{ performance.salesOpenAt ? performance.salesOpenAt|date('d/m H:i') : '—' }}
                                                –
                                                {{ performance.salesCloseAt ? performance.salesCloseAt|date('d/m H:i') : '—' }}
                                            {% else %}
                                                Always on sale
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if performance.status.value == 'CANCELLED' %}
                                                <span class="badge badge--danger">Cancelled</span>
                                            {% elseif performance.status.value == 'COMPLETED' %}
                                                <span class="badge">Completed</span>
                                            {% else %}
                                                <span class="badge badge--success">Scheduled</span>
                                            {% endif %}
                                        </td>
                                        <td class="table__cell--actions">
                                            <span class="u-flex u-gap-2" style="justify-content: flex-end;">
                                                <a class="button button--ghost button--icon" href="{{ path('admin_performances_edit', {eventId: event.id, id: performance.id}) }}"
                                                   title="Edit" aria-label="Edit the performance">
                                                    {{ icon('pencil', 'icon icon--sm') }}
                                                </a>
                                                {% if performance.status.value != 'CANCELLED' %}
                                                    <form method="post" action="{{ path('admin_performances_cancel', {eventId: event.id, id: performance.id}) }}"
                                                          data-turbo-confirm="Cancel the performance of {{ performance.startsAt|date('d/m/Y') }}? It stops being sold.">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_performance_' ~ performance.id) }}">
                                                        <button class="button button--ghost button--icon" type="submit"
                                                                title="Cancel" aria-label="Cancel the performance">
                                                            {{ icon('close', 'icon icon--sm') }}
                                                        </button>
                                                    </form>
                                                {% endif %}
                                                <form method="post" action="{{ path('admin_performances_delete', {eventId: event.id, id: performance.id}) }}"
                                                      data-turbo-confirm="Delete this performance? Its inventory will be deleted too. This cannot be undone.">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_performance_' ~ performance.id) }}">
                                                    <button class="button button--danger-ghost button--icon" type="submit"
                                                            title="Delete" aria-label="Delete the performance">
                                                        {{ icon('trash', 'icon icon--sm') }}
                                                    </button>
                                                </form>
                                            </span>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            {% endset %}

            {% include '_components/card.html.twig' with {
                title: 'Performances',
                subtitle: 'The dated shows of the programme.',
                body: performancesBody,
            } %}
        </div>
    </div>
{% endblock %}
