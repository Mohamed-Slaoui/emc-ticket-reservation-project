{% extends 'base.html.twig' %}

{% block title %}{{ zone ? 'Edit the zone' : 'New zone' }}{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: zone ? 'Edit the zone' : 'New zone',
        subtitle: zone
            ? 'Change the code, the name or the description of the zone.'
            : 'A zone groups the seats that share the same price.',
        action_label: 'Back to the seat map',
        action_path: path('admin_layouts_show', {id: layout.id}),
        action_icon: 'arrow-left',
        action_variant: 'outline',
    } %}

    {% include '_components/flash.html.twig' %}

    {% set form %}
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_row(form.code) }}
            {{ form_row(form.name) }}
            {{ form_row(form.description) }}

            <div class="form__actions">
                <button type="submit" class="button button--primary">
                    {{ zone ? 'Save the changes' : 'Create the zone' }}
                </button>
                <a class="button button--ghost" href="{{ path('admin_layouts_show', {id: layout.id}) }}">Cancel</a>
            </div>
        {{ form_end(form) }}
    {% endset %}

    {% include '_components/card.html.twig' with { body: form } %}
{% endblock %}
