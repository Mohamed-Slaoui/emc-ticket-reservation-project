{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}Seating layouts{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: 'Seating layouts',
        subtitle: 'The versioned configurations of the rooms: the zones and the seats they group.',
        action_label: 'Add a configuration',
        action_path: path('admin_layouts_new'),
        action_icon: 'plus',
    } %}

    {% include '_components/flash.html.twig' %}

    {% if layouts is empty %}
        {% include '_components/empty_state.html.twig' with {
            iconName: 'layout',
            title: room ? 'No configuration in this room' : 'No configuration yet',
            text: room
                ? 'This room has no configuration yet.'
                : 'Create a configuration, then define its zones and map the seats of the room.',
            action_label: 'Add a configuration',
            action_path: path('admin_layouts_new'),
            action_icon: 'plus',
        } %}
    {% else %}
        {% set body %}
            <form method="get" class="list-toolbar" data-turbo="false">
                <div class="search">
                    <span class="search__icon">{{ icon('filter', 'icon icon--sm') }}</span>
                    <select class="search__input" name="room">
                        <option value="">Every room</option>
                        {% for r in rooms %}
                            <option value="{{ r.id }}" {{ room and room.id == r.id ? 'selected' : '' }}>
                                {{ r.venue.name }} — {{ r.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="button button--outline">Filter</button>
                {% if room %}
                    <a class="button button--ghost" href="{{ path('admin_layouts') }}">Clear</a>
                {% endif %}

                {% include '_components/page_size.html.twig' with {current: perPage} %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Configuration</th>
                            <th>Version</th>
                            <th>Room</th>
                            <th>Zones</th>
                            <th>Seats</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for layout in layouts %}
                            <tr>
                                <td>
                                    <div class="table__identity">
                                        <span class="card__icon">{{ icon('layout', 'icon icon--sm') }}</span>
                                        <div class="table__identity-text">
                                            <div class="table__identity-name">{{ layout.name }}</div>
                                            {% if layout.description %}
                                                <div class="table__identity-mail">{{ layout.description }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge badge--accent">v{{ layout.version }}</span></td>
                                <td class="table__cell--muted">{{ layout.room.venue.name }} — {{ layout.room.name }}</td>
                                <td>
                                    <span class="badge">{{ zoneCounts[layout.id] }} zone{{ zoneCounts[layout.id] > 1 ? 's' : '' }}</span>
                                </td>
                                <td>
                                    <span class="badge">{{ placeCounts[layout.id] }} seat{{ placeCounts[layout.id] > 1 ? 's' : '' }}</span>
                                </td>
                                <td class="table__cell--actions">
                                    <span class="u-flex u-gap-2" style="justify-content: flex-end;">
                                        <a class="button button--ghost button--icon" href="{{ path('admin_layouts_show', {id: layout.id}) }}"
                                           title="Seat map" aria-label="Seat map of {{ layout.name }}">
                                            {{ icon('seat', 'icon icon--sm') }}
                                        </a>
                                        <a class="button button--ghost button--icon" href="{{ path('admin_layouts_edit', {id: layout.id}) }}"
                                           title="Edit" aria-label="Edit {{ layout.name }}">
                                            {{ icon('pencil', 'icon icon--sm') }}
                                        </a>
                                        <form method="post" action="{{ path('admin_layouts_delete', {id: layout.id}) }}"
                                              data-turbo-confirm="Delete the configuration {{ layout.name }} v{{ layout.version }}? This cannot be undone.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_layout_' ~ layout.id) }}">
                                            <button class="button button--danger-ghost button--icon" type="submit"
                                                    title="Delete" aria-label="Delete {{ layout.name }}">
                                                {{ icon('trash', 'icon icon--sm') }}
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set footer %}
            {% include '_components/pagination.html.twig' with {
                pagination: pagination,
                route: 'admin_layouts',
                query: {room: room ? room.id : null},
            } %}
        {% endset %}

        {% include '_components/card.html.twig' with {
            variant: 'card--flat',
            body: body,
            footer: footer,
        } %}
    {% endif %}
{% endblock %}
