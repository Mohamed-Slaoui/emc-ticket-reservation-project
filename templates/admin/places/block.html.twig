{% extends 'base.html.twig' %}

{% block title %}Add a block of places{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: 'Add a block of places',
        subtitle: 'Fill a room with a whole row of seats, or a pit of standing slots.',
        action_label: 'Back to the places',
        action_path: path('admin_places'),
        action_icon: 'arrow-left',
        action_variant: 'outline',
    } %}

    {% include '_components/flash.html.twig' %}

    {% set form %}
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_row(form.room) }}
            {{ form_row(form.type) }}

            <div class="form__grid">
                {{ form_row(form.rowLabel) }}
                {{ form_row(form.codePrefix) }}
            </div>

            <div class="form__grid">
                {{ form_row(form.from) }}
                {{ form_row(form.to) }}
            </div>

            <div class="form__actions">
                <button type="submit" class="button button--primary">Create the places</button>
                <a class="button button--ghost" href="{{ path('admin_places') }}">Cancel</a>
            </div>
        {{ form_end(form) }}
    {% endset %}

    {% include '_components/card.html.twig' with { body: form } %}
{% endblock %}
