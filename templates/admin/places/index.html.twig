{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}Places{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: 'Places',
        subtitle: 'The numbered seats and the standing slots of the rooms.',
        action_label: 'Add a block of places',
        action_path: path('admin_places_block'),
        action_icon: 'plus',
    } %}

    {% include '_components/flash.html.twig' %}

    {% if places is empty %}
        {% include '_components/empty_state.html.twig' with {
            iconName: 'seat',
            title: room ? 'No place in this room' : 'No place yet',
            text: room
                ? 'This room holds no place yet.'
                : 'Fill the room with its seats — a whole row at a time.',
            action_label: 'Add a block of places',
            action_path: path('admin_places_block'),
            action_icon: 'plus',
        } %}
    {% else %}
        {% set body %}
            <form method="get" class="list-toolbar" data-turbo="false">
                <div class="search">
                    <span class="search__icon">{{ icon('filter', 'icon icon--sm') }}</span>
                    <select class="search__input" name="room">
                        <option value="">Every room</option>
                        {% for r in rooms %}
                            <option value="{{ r.id }}" {{ room and room.id == r.id ? 'selected' : '' }}>
                                {{ r.venue.name }} — {{ r.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="button button--outline">Filter</button>
                {% if room %}
                    <a class="button button--ghost" href="{{ path('admin_places') }}">Clear</a>
                {% endif %}

                {% include '_components/page_size.html.twig' with {current: perPage} %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Place</th>
                            <th>Code</th>
                            <th>Type</th>
                            <th>Room</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for place in places %}
                            <tr>
                                <td>
                                    <div class="table__identity">
                                        <span class="card__icon">{{ icon('seat', 'icon icon--sm') }}</span>
                                        <div class="table__identity-text">
                                            <div class="table__identity-name">{{ place.label }}</div>
                                            {% if place.rowLabel %}
                                                <div class="table__identity-mail">Row {{ place.rowLabel }}{{ place.seatNumber ? ' · seat ' ~ place.seatNumber }}</div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </td>
                                <td class="table__cell--muted"><span class="u-mono">{{ place.code }}</span></td>
                                <td>
                                    <span class="badge">{{ place.type.value == 'SEAT' ? 'Seat' : 'Standing slot' }}</span>
                                </td>
                                <td class="table__cell--muted">{{ place.room.name }}</td>
                                <td>
                                    {% if place.isActive %}
                                        <span class="badge badge--success">In service</span>
                                    {% else %}
                                        <span class="badge badge--warning">Out of service</span>
                                    {% endif %}
                                    {% if place.id in mapped %}
                                        <span class="badge badge--accent" title="Mapped in a seating layout">Mapped</span>
                                    {% endif %}
                                </td>
                                <td class="table__cell--actions">
                                    <span class="u-flex u-gap-2" style="justify-content: flex-end;">
                                        <a class="button button--ghost button--icon" href="{{ path('admin_places_edit', {id: place.id}) }}"
                                           title="Edit" aria-label="Edit {{ place.code }}">
                                            {{ icon('pencil', 'icon icon--sm') }}
                                        </a>
                                        <form method="post" action="{{ path('admin_places_toggle', {id: place.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_place_' ~ place.id) }}">
                                            <button class="button button--ghost button--icon" type="submit"
                                                    title="{{ place.isActive ? 'Take out of service' : 'Put back in service' }}"
                                                    aria-label="Toggle {{ place.code }}">
                                                {{ icon(place.isActive ? 'lock' : 'check', 'icon icon--sm') }}
                                            </button>
                                        </form>
                                        <form method="post" action="{{ path('admin_places_delete', {id: place.id}) }}"
                                              data-turbo-confirm="Delete the place {{ place.code }}? It will be removed from the seating configurations. This cannot be undone.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_place_' ~ place.id) }}">
                                            <button class="button button--danger-ghost button--icon" type="submit"
                                                    title="Delete" aria-label="Delete {{ place.code }}">
                                                {{ icon('trash', 'icon icon--sm') }}
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set footer %}
            {% include '_components/pagination.html.twig' with {
                pagination: pagination,
                route: 'admin_places',
                query: {room: room ? room.id : null},
            } %}
        {% endset %}

        {% include '_components/card.html.twig' with {
            variant: 'card--flat',
            body: body,
            footer: footer,
        } %}
    {% endif %}
{% endblock %}
