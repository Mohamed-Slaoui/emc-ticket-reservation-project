{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon, initials %}

{% block title %}Accounts{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: 'Accounts',
        subtitle: 'Everyone who can sign in to the application.',
        action_label: 'Add an account',
        action_path: path('admin_users_new'),
        action_icon: 'plus',
    } %}

    {% include '_components/flash.html.twig' %}

    {% if users is empty %}
        {% include '_components/empty_state.html.twig' with {
            iconName: 'users',
            title: 'No account found',
            text: search
                ? ('No account matches "' ~ search ~ '".')
                : 'Create the first account to give access to the venue.',
            action_label: 'Add an account',
            action_path: path('admin_users_new'),
            action_icon: 'plus',
        } %}
    {% else %}
        {% set body %}
            <form method="get" class="u-flex u-gap-2" style="margin-bottom: var(--space-4);">
                <div class="search" style="max-width: 22rem;">
                    <span class="search__icon">{{ icon('search', 'icon icon--sm') }}</span>
                    <input class="search__input" type="search" name="search" value="{{ search }}"
                           placeholder="Search by name or email">
                </div>
                {% if search %}
                    <a class="button button--ghost" href="{{ path('admin_users') }}">Clear</a>
                {% endif %}
            </form>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Roles</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td>
                                    <div class="table__identity">
                                        <span class="avatar {{ loop.index % 3 == 0 ? 'avatar--coral' : (loop.index % 3 == 1 ? 'avatar--teal' : '') }}">
                                            {{ initials(user.firstName, user.lastName) }}
                                        </span>
                                        <div class="table__identity-text">
                                            <div class="table__identity-name">{{ user.firstName }} {{ user.lastName }}</div>
                                            <div class="table__identity-mail">{{ user.email }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="u-flex u-wrap u-gap-2">
                                        {% for role in user.businessRoles %}
                                            <span class="badge badge--accent">{{ role|replace({'ROLE_': ''}) }}</span>
                                        {% endfor %}
                                    </span>
                                </td>
                                <td>
                                    {% if user.isActive %}
                                        <span class="badge badge--success">Enabled</span>
                                    {% else %}
                                        <span class="badge badge--danger">Disabled</span>
                                    {% endif %}
                                </td>
                                <td class="table__cell--muted">{{ user.createdAt|date('j M Y') }}</td>
                                <td class="table__cell--actions">
                                    <span class="u-flex u-gap-2" style="justify-content: flex-end;">
                                        <a class="button button--ghost button--icon" href="{{ path('admin_users_edit', {id: user.id}) }}"
                                           title="Edit" aria-label="Edit {{ user.email }}">
                                            {{ icon('pencil', 'icon icon--sm') }}
                                        </a>
                                        <form method="post" action="{{ path('admin_users_toggle', {id: user.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle_user_' ~ user.id) }}">
                                            <button class="button button--ghost button--icon" type="submit"
                                                    title="{{ user.isActive ? 'Disable' : 'Enable' }}"
                                                    aria-label="{{ user.isActive ? 'Disable' : 'Enable' }} {{ user.email }}">
                                                {{ icon(user.isActive ? 'lock' : 'check', 'icon icon--sm') }}
                                            </button>
                                        </form>
                                        <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}"
                                              data-turbo-confirm="Delete the account of {{ user.email }}? This cannot be undone.">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                            <button class="button button--danger-ghost button--icon" type="submit"
                                                    title="Delete" aria-label="Delete {{ user.email }}">
                                                {{ icon('trash', 'icon icon--sm') }}
                                            </button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% include '_components/card.html.twig' with {
            variant: 'card--flat',
            body: body,
        } %}

        {% include '_components/pagination.html.twig' with {
            pagination: pagination,
            route: 'admin_users',
            query: {search: search},
        } %}
    {% endif %}
{% endblock %}
