{% extends 'base.html.twig' %}

{% block title %}New password{% endblock %}

{% block content %}
    {% include '_components/page_header.html.twig' with {
        title: 'New password',
        subtitle: 'Set a new password for ' ~ user.firstName ~ ' ' ~ user.lastName ~ ' (' ~ user.email ~ ').',
        action_label: 'Back to the account',
        action_path: path('admin_users_edit', {id: user.id}),
        action_icon: 'arrow-left',
        action_variant: 'outline',
    } %}

    {% include '_components/flash.html.twig' %}

    {% set form %}
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_row(form.plainPassword) }}

            <div class="form__actions">
                <button type="submit" class="button button--primary">Change the password</button>
                <a class="button button--ghost" href="{{ path('admin_users_edit', {id: user.id}) }}">Cancel</a>
            </div>
        {{ form_end(form) }}
    {% endset %}

    <div class="grid grid--halves">
        {% include '_components/card.html.twig' with { body: form } %}
    </div>
{% endblock %}
