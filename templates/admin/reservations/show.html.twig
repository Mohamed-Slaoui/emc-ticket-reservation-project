{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}Reservation {{ reservation.reference }}{% endblock %}

{% block content %}
    {% set status = reservation.status.value %}

    {% include '_components/page_header.html.twig' with {
        title: 'Reservation ' ~ reservation.reference,
        subtitle: reservation.performance.event.title ~ ' · ' ~ reservation.performance.startsAt|date('d/m/Y H:i'),
        action_label: 'Reservations',
        action_path: path('admin_reservations'),
        action_icon: 'arrow-left',
        action_variant: 'outline',
    } %}

    <div class="card card--flat">
        <div class="card__body">
            <div class="booking__summary u-flex u-gap-3" style="margin-bottom: var(--space-5);">
                <div class="table__identity-text">
                    <div class="table__identity-mail">Status</div>
                    <div class="table__identity-name">
                        {% if status == 'HELD' %}
                            <span class="badge badge--warning">Held until {{ reservation.expiresAt|date('H:i') }}</span>
                        {% elseif status == 'CONFIRMED' %}
                            <span class="badge badge--success">Confirmed</span>
                        {% elseif status == 'EXPIRED' %}
                            <span class="badge">Expired</span>
                        {% else %}
                            <span class="badge badge--danger">Cancelled</span>
                        {% endif %}
                    </div>
                </div>
                <div class="table__identity-text">
                    <div class="table__identity-mail">Channel</div>
                    <div class="table__identity-name">{{ reservation.channel.value == 'ONLINE' ? 'Online' : 'Box office' }}</div>
                </div>
                <div class="table__identity-text">
                    <div class="table__identity-mail">Customer</div>
                    <div class="table__identity-name">{{ reservation.customer ? reservation.customer.firstName ~ ' ' ~ reservation.customer.lastName : 'Anonymous sale' }}</div>
                </div>
                <div class="table__identity-text">
                    <div class="table__identity-mail">Total</div>
                    <div class="table__identity-name u-mono">{{ reservation.totalAmount }} {{ reservation.currency }}</div>
                </div>
                <div class="table__identity-text">
                    <div class="table__identity-mail">Seats</div>
                    <div class="table__identity-name">{{ reservation.items|length }}</div>
                </div>
            </div>

            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Zone</th>
                            <th>Seat</th>
                            <th>Tariff</th>
                            <th>Price</th>
                            <th>Sales point</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in reservation.items %}
                            <tr>
                                <td>{{ item.performancePlace.layoutPlace.layoutZone.name }}</td>
                                <td class="u-mono">{{ item.performancePlace.layoutPlace.place.code }}</td>
                                <td>{{ item.tariffNameSnapshot }}</td>
                                <td class="u-mono">{{ item.unitPriceSnapshot }} {{ item.currencySnapshot }}</td>
                                <td class="u-mono">{{ reservation.createdBy.email }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if reservation.payments is not empty %}
                <h2 class="table__identity-name" style="margin: var(--space-5) 0 var(--space-3);">Payments and refunds</h2>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Captured at</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for payment in reservation.payments %}
                                <tr>
                                    <td>{{ payment.method.value == 'ONLINE' ? 'Online' : (payment.method.value == 'CASH' ? 'Cash' : 'Card terminal') }}</td>
                                    <td class="u-mono">{{ payment.amount }} {{ payment.currency }}</td>
                                    <td>
                                        {% if payment.status.value == 'SUCCEEDED' %}
                                            <span class="badge badge--success">Succeeded</span>
                                        {% elseif payment.status.value == 'FAILED' %}
                                            <span class="badge badge--danger">Failed</span>
                                        {% else %}
                                            <span class="badge">Pending</span>
                                        {% endif %}
                                    </td>
                                    <td class="u-mono u-small">{{ payment.completedAt ? payment.completedAt|date('d/m/Y H:i') : '—' }}</td>
                                </tr>
                                {% for refund in payment.refunds %}
                                    <tr style="background: var(--surface-muted);">
                                        <td class="u-muted u-small">Refund</td>
                                        <td class="u-mono u-muted u-small">{{ refund.amount }} {{ payment.currency }}</td>
                                        <td>
                                            {% if refund.status.value == 'SUCCEEDED' %}
                                                <span class="badge badge--success">Succeeded</span>
                                            {% elseif refund.status.value == 'FAILED' %}
                                                <span class="badge badge--danger">Failed</span>
                                            {% else %}
                                                <span class="badge badge--warning">Pending</span>
                                            {% endif %}
                                        </td>
                                        <td class="u-mono u-small">{{ refund.completedAt ? refund.completedAt|date('d/m/Y H:i') : refund.createdAt|date('d/m/Y H:i') }}</td>
                                    </tr>
                                    {% if refund.reason %}
                                        <tr style="background: var(--surface-muted);">
                                            <td colspan="4" class="u-muted u-small">Reason: {{ refund.reason }}</td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {% if tickets is not empty %}
                <h2 class="table__identity-name" style="margin: var(--space-5) 0 var(--space-3);">Tickets</h2>
                <div class="table-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Seat</th>
                                <th>Status</th>
                                <th>Claim code</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ticket in tickets %}
                                <tr>
                                    <td class="u-mono">{{ ticket.ticketNumber }}</td>
                                    <td class="u-mono">{{ ticket.reservationItem.performancePlace.layoutPlace.place.code }}</td>
                                    <td>{{ ticket.status.value == 'VALID' ? 'Valid' : (ticket.status.value == 'USED' ? 'Used' : 'Void') }}</td>
                                    <td><span class="u-mono u-small">{{ ticket.qrToken }}</span></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="u-muted u-small" style="margin-top: var(--space-4);">No ticket yet — payment is pending or the reservation is not confirmed.</p>
            {% endif %}

            {% if status in ['HELD', 'CONFIRMED'] %}
                <div class="form__actions" style="margin-top: var(--space-5);">
                    <form method="post" action="{{ path('admin_reservation_cancel', {id: reservation.id}) }}"
                          data-turbo-confirm="Cancel this reservation?{% if status == 'CONFIRMED' %} A full refund is issued and the tickets are voided.{% endif %}">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_reservation_' ~ reservation.id) }}">
                        <button type="submit" class="button button--danger">
                            {{ icon('close', 'icon icon--sm') }}
                            Cancel this reservation
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
