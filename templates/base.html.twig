<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>{% block title %}Ticketing{% endblock %} — Ticketing</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%228%22 fill=%22%23167D7F%22/><path d=%22M9 21v-9l7-4 7 4v9%22 fill=%22none%22 stroke=%22%23fff%22 stroke-width=%222%22 stroke-linejoin=%22round%22/><path d=%22M13 21v-5h6v5%22 fill=%22none%22 stroke=%22%23fff%22 stroke-width=%222%22/></svg>">
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% endblock %}
</head>
<body>
{% block shell %}
    <div class="shell" data-controller="sidebar">
        {% block sidebar %}
            {% include '_partials/sidebar.html.twig' %}
        {% endblock %}

        <div class="shell__main">
            {% block topbar %}
                {% include '_partials/topbar.html.twig' %}
            {% endblock %}

            <main class="content" id="main-content">
                {% block content %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ importmap('app') }}
{% endblock %}
</body>
</html>
