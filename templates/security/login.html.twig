{% extends 'base.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}Sign in{% endblock %}

{% block shell %}
    <div class="auth">
        <div class="auth__card">
            <div class="auth__brand">
                <span class="sidebar__mark">{{ icon('ticket', 'icon icon--lg') }}</span>
                <span class="sidebar__wordmark">EMC Ticketing</span>
            </div>

            <h1 style="font-size: var(--text-2xl); margin-bottom: var(--space-2);">Sign in</h1>
            <p class="u-muted u-small" style="margin-bottom: var(--space-6);">
                Sign in to your account to hold seats and buy tickets.
            </p>

            {% if error %}
                {% include '_components/alert.html.twig' with {
                    variant: 'danger',
                    iconName: 'alert',
                    message: error.messageKey|trans(error.messageData, 'security'),
                } %}
                <div style="height: var(--space-4);"></div>
            {% endif %}

            {% include '_components/flash.html.twig' %}

            {# The sign in is a plain navigation: the authentication must not
               depend on the JavaScript layer to deliver its answer. #}
            <form method="post" class="form" data-turbo="false">
                <div class="form__group">
                    <label class="form__label" for="username">
                        Email address<span class="form__required" aria-hidden="true">*</span>
                    </label>
                    <input class="form__control" type="email" id="username" name="_username"
                           value="{{ last_username }}" required autofocus autocomplete="username"
                           placeholder="you@venue.test">
                </div>

                <div class="form__group">
                    <label class="form__label" for="password">
                        Password<span class="form__required" aria-hidden="true">*</span>
                    </label>
                    <input class="form__control" type="password" id="password" name="_password"
                           required autocomplete="current-password" placeholder="••••••••">
                </div>

                {# The `csrf-protection` controller loads the script that sets the
                   double-submit cookie: without it, the sign in only works as long
                   as the session has not recorded another validation strategy. #}
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"
                       data-controller="csrf-protection">

                <button type="submit" class="button button--primary button--block button--lg">Sign in</button>
            </form>

            <p class="u-muted u-small" style="margin-top: var(--space-6);">
                No account yet? <a href="{{ path('app_register') }}">Sign up</a>.
            </p>
        </div>
    </div>
{% endblock %}
