{% extends 'base_public.html.twig' %}

{% from '_partials/icons.html.twig' import icon %}

{% block title %}{{ event.title }}{% endblock %}

{% block content %}
    <div class="public-page-title">
        <a class="button button--ghost button--icon" href="{{ path('booking_index') }}" title="Back to the programme" aria-label="Back to the programme">
            {{ icon('arrow-left', 'icon icon--sm') }}
        </a>
        <h1 class="public-heading">{{ event.title }}</h1>
    </div>

    {% if event.description %}
        <p class="public-lead">{{ event.description }}</p>
    {% endif %}

    {% set body %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Venue</th>
                        <th>From</th>
                        <th>Seats left</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for performance in performances %}
                        {% set left = available[performance.id] %}
                        <tr>
                            <td class="u-nowrap">
                                <div class="table__identity-text">
                                    <div class="table__identity-name">{{ performance.startsAt|date('d/m/Y') }}</div>
                                    <div class="table__identity-mail u-mono">{{ performance.startsAt|date('H:i') }}</div>
                                </div>
                            </td>
                            <td>
                                <div class="table__identity-text">
                                    <div class="table__identity-name">{{ performance.seatingLayout.room.venue.name }}</div>
                                    <div class="table__identity-mail u-mono">{{ performance.seatingLayout.room.name }}</div>
                                </div>
                            </td>
                            <td class="u-mono">
                                {% if fromAmounts[performance.id] is defined and fromAmounts[performance.id] %}
                                    {{ fromAmounts[performance.id] }} MAD
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td>
                                {% if left > 0 %}
                                    {{ left }}
                                {% else %}
                                    <span class="badge badge--danger">Sold out</span>
                                {% endif %}
                            </td>
                            <td class="table__cell--actions">
                                <a class="button button--primary button--sm"
                                   href="{{ path('booking_show', {eventId: event.id, performanceId: performance.id}) }}">
                                    {{ icon('ticket', 'icon icon--sm') }}
                                    {{ left > 0 ? 'Book' : 'Details' }}
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endset %}

    {% include '_components/card.html.twig' with { variant: 'card--flat', body: body } %}
{% endblock %}
