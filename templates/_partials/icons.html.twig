{#
    Inline SVG icon set.

    The icons are plain stroke paths drawn on a 24x24 grid, so they inherit
    the colour of their context through `currentColor` and need no external
    dependency, sprite file or icon font.

    Usage:
        {% from '_partials/icons.html.twig' import icon %}
        {{ icon('dashboard') }}
        {{ icon('calendar', 'icon icon--sm') }}
#}

{% macro icon(name, class = 'icon') %}
    {%- set paths = {
        'dashboard': '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
        'venue': '<path d="M3 21h18"/><path d="M5 21V6a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v15"/><path d="M14 10h4a1 1 0 0 1 1 1v10"/><path d="M8.5 9h2.5M8.5 13h2.5M8.5 17h2.5"/>',
        'room': '<path d="M4 21h16"/><path d="M6 21V3.5A1.5 1.5 0 0 1 7.5 2H18v19"/><circle cx="14.5" cy="12" r="1"/>',
        'seat': '<path d="M6 10V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v2"/><path d="M5 10h14a1 1 0 0 1 1 1v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-5a1 1 0 0 1 1-1Z"/><path d="M7 18v2M17 18v2"/>',
        'layout': '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 10h18M10 3v18"/>',
        'calendar': '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>',
        'clock': '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
        'pricing': '<path d="M20.6 13.4 12 22l-9-9V4a1 1 0 0 1 1-1h9l8.6 8.6a1.4 1.4 0 0 1 0 1.8Z"/><circle cx="7.5" cy="7.5" r="1.2"/>',
        'ticket': '<path d="M3 9.5V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2.5a2.5 2.5 0 0 0 0 5V17a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2.5a2.5 2.5 0 0 0 0-5Z"/><path d="M13 6v2M13 11v2M13 16v2"/>',
        'scan': '<path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/><path d="M3 12h18"/>',
        'users': '<path d="M16 20v-1a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v1"/><circle cx="9.5" cy="7" r="3.5"/><path d="M17 11a3.5 3.5 0 1 0-1.6-6.6"/><path d="M21 20v-1a4 4 0 0 0-3-3.9"/>',
        'user': '<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/>',
        'settings': '<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h10M18 18h2"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="16" cy="18" r="2"/>',
        'help': '<circle cx="12" cy="12" r="9"/><path d="M9.6 9.6a2.5 2.5 0 1 1 3.4 2.2c-.6.3-.9.8-.9 1.4v.3"/><circle cx="12" cy="16.8" r=".9" fill="currentColor" stroke="none"/>',
        'logout': '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>',
        'plus': '<path d="M12 5v14M5 12h14"/>',
        'minus': '<path d="M5 12h14"/>',
        'search': '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>',
        'mail': '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
        'bell': '<path d="M18 8a6 6 0 1 0-12 0c0 6-3 7-3 7h18s-3-1-3-7"/><path d="M13.7 20.5a2 2 0 0 1-3.4 0"/>',
        'chevron-down': '<path d="m6 9 6 6 6-6"/>',
        'chevron-right': '<path d="m9 6 6 6-6 6"/>',
        'arrow-left': '<path d="M19 12H5M11 18l-6-6 6-6"/>',
        'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
        'pencil': '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
        'trash': '<path d="M3 6h18M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/>',
        'check': '<path d="m4 12.5 5 5L20 6.5"/>',
        'close': '<path d="M18 6 6 18M6 6l12 12"/>',
        'alert': '<path d="M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z"/><path d="M12 9.5v4M12 17.2h.01"/>',
        'info': '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
        'eye': '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
        'eye-off': '<path d="M10.6 6.2A9.9 9.9 0 0 1 12 6c6.4 0 10 6 10 6a17 17 0 0 1-3.2 3.9M6.6 6.7A17 17 0 0 0 2 12s3.6 6 10 6a9.6 9.6 0 0 0 4.2-.9"/><path d="m2 2 20 20"/>',
        'lock': '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
        'menu': '<path d="M4 6h16M4 12h16M4 18h16"/>',
        'inbox': '<path d="M3 13h5l1.5 3h5L16 13h5"/><path d="M5.5 5h13l2.5 8v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4Z"/>',
        'download': '<path d="M12 3v12M7.5 10.5 12 15l4.5-4.5"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',
        'upload': '<path d="M12 16V4M7.5 8.5 12 4l4.5 4.5"/><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>',
        'filter': '<path d="M3 5h18l-7 8v6l-4 2v-8Z"/>',
        'more': '<circle cx="5" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1.4" fill="currentColor" stroke="none"/>'
    } -%}
    {%- set path = paths[name]|default(paths['dashboard']) -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ path|raw }}</svg>
{% endmacro %}

{# The initial letters of a name, used by the avatar component. #}
{% macro initials(firstName, lastName = '') %}
    {%- set letters = (firstName|default('')|slice(0, 1) ~ lastName|default('')|slice(0, 1))|upper -%}
    {{- letters|default('?') -}}
{% endmacro %}
