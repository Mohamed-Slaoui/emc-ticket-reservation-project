{#
    Flash messages — the notifications raised by the controllers.

    The flash *type* (`success`, `danger`, `warning`, `info`) is mapped to a
    variant of the alert component.
#}

{% set variants = {
    'success': 'success',
    'error': 'danger',
    'danger': 'danger',
    'warning': 'warning',
    'info': 'info'
} %}
{% set icons = {
    'success': 'check',
    'error': 'alert',
    'danger': 'alert',
    'warning': 'alert',
    'info': 'info'
} %}

{% for type, messages in app.flashes %}
    {% set variant = variants[type]|default('info') %}
    {% set iconName = icons[type]|default('info') %}

    {% for message in messages %}
        {% include '_components/alert.html.twig' with {
            variant: variant,
            iconName: iconName,
            message: message,
        } %}
    {% endfor %}
{% endfor %}
