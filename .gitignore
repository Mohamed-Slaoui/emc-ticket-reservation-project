# ==============================================================================
# Environment files - never commit secrets
# ==============================================================================
# .env.dev contains a real APP_SECRET -> keep it out of the repository.
# .env.test only holds the public Symfony test placeholder -> safe to commit.
# Real credentials belong in .env.local / .env.$env.local, which are ignored.
# .env.example (when added) must contain NO secret and SHOULD be committed.
/.env.dev
/.env.prod
/.env.prod.local
/.env.*.local
.env.local.php
*.local.php

# Symfony CLI local configuration
/.symfony.local.yaml
/.symfony.local.php

# ==============================================================================
# Secrets, private keys & credentials
# ==============================================================================
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.secret
config/jwt/
config/secrets/

